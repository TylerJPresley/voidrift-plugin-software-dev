{
  "name": "@voidrift/plugin-software-dev",
  "version": "0.1.0",
  "description": "VoidRift Software Development — development skills, agents and tools on top of the generic core.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "seed",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@voidrift/core": "^0.1.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@langchain/core": "1.2.17",
    "@types/node": "24.19.2",
    "@voidrift/core": "^0.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "plugin",
    "plugin": true,
    "description": "Software development skills, agents and tools on the generic core (§2)."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-plugin-software-dev.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-plugin-software-dev/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-plugin-software-dev#readme",
  "keywords": [
    "voidrift",
    "software",
    "development",
    "skills",
    "agents",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
